# Copy to .env (git-ignored) and fill in your own key. Never commit .env.
# Groq free tier: https://console.groq.com -> API Keys
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=gsk_your_key_here
LLM_MODEL=qwen/qwen3.8-27b

# Alternative: local Ollama (no key, no limits; `ollama pull qwen3:8b` first)
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=qwen3:8b
